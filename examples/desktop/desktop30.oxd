# A Linux desktop in Docker, driven by name, in 30 seconds.
# `skip` waits for real but cuts the wait out of the video.
#
#   docker build -t oxdemo-desktop examples/desktop
#   docker run -d --name desk --network host oxdemo-desktop
#   oxdemo record examples/desktop/desktop30.oxd
before "docker restart desk >/dev/null && sleep 4 && docker cp desktop30.oxd desk:/home/demo/"
url "localhost:6080/vnc.html?autoconnect=1&resize=off&reconnect=1"
viewport 1440x900
style "#noVNC_control_bar_anchor, #noVNC_status { display: none !important }"
pace 0.4
theme size=42 offset=70
gif width=720 fps=8

say "Nobody is touching this mouse."
say "oxdemo drives it from a script."
click "Applications"
hover "Graphics"
hover "GNU Image Manipulation Program"
click "GNU Image Manipulation Program"
skip 14s
say "Slow waits are cut out."
double-click "GNU Image Manipulation Program"

say "Every click is one line of script."
click "File"
hover "New..."
click "New..."
click "OK"
click "Filters"
hover "Render"
hover "Noise"
hover "Plasma..."
click "Plasma..."
click "OK"

say "It zooms in on the action."
click @77,145
zoom 1.6
draw @330,600 @450,520 @600,580 @750,480 @900,560 @1080,470
zoom off

say "Out comes an MP4 and a GIF."
click "Filters"
hover "Distorts"
hover "Waves..."
click "Waves..."
click "OK"

say "This is the whole script."
click "Applications"
hover "Terminal Emulator"
click "Terminal Emulator"
skip 2s
type "mousepad desktop30.oxd"
key Enter
skip 2s
hover @520,420
zoom 1.4
pause 1.2s
say ""
wheel 6000 2.5s
pause 1.2s
zoom off
