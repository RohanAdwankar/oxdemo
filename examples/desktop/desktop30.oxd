# The 30 second cut. `skip` waits for real but cuts the wait out of the video.
#
#   docker build -t oxdemo-desktop examples/desktop
#   docker run -d --name desk --network host oxdemo-desktop
#   oxdemo record examples/desktop/desktop30.oxd
before "docker restart desk >/dev/null && sleep 4 && docker cp desktop30.oxd desk:/home/demo/"
url "localhost:6080/vnc.html?autoconnect=1&resize=off&reconnect=1"
viewport 1440x900
style "#noVNC_control_bar_anchor, #noVNC_status { display: none !important }"
pace 0.4
theme size=26 offset=90
gif width=720 fps=8

say "A Linux desktop in Docker. Open GIMP from the menu."
click @55,12
hover @55,221
hover @170,221
hover @300,221
click @300,221
skip 14s
double-click @683,113

say "Make a new image and render a plasma cloud."
click @18,64
hover @18,93
click @40,93
skip 1.2s
click @875,556
skip 600ms
click @393,64
hover @420,459
hover @600,459
hover @720,484
hover @900,484
hover @910,534
click @910,534
skip 1s
click @1050,682

say "Paint on it."
click @77,145
zoom 1.6
draw @330,600 @450,520 @600,580 @750,480 @900,560 @1080,470
key x
draw @330,660 @480,600 @640,650 @800,560 @960,630 @1100,560
zoom off

say "Bend it with Waves."
click @393,64
hover @393,90
hover @422,259
hover @690,259
hover @719,584
click @719,584
skip 1s
click @1050,822

say "All of it came from this script."
click @55,12
hover @86,69
click @86,69
skip 2s
type "mousepad desktop30.oxd"
key Enter
skip 2s
zoom 1.6
hover @300,300
hover @340,560
zoom off
say ""
