# The 30 second cut: GIMP and this file are already open when the take starts.
#
#   docker build -t oxdemo-desktop examples/desktop
#   docker run -d --name desk --network host oxdemo-desktop
#   oxdemo record examples/desktop/desktop30.oxd
before "docker restart desk >/dev/null && sleep 4 && docker cp canvas.png desk:/home/demo/ && docker cp desktop30.oxd desk:/home/demo/"
before "docker exec -d -e DISPLAY=:1 desk mousepad desktop30.oxd && sleep 2 && docker exec -d -e DISPLAY=:1 desk gimp canvas.png && sleep 20"
url "localhost:6080/vnc.html?autoconnect=1&resize=off&reconnect=1"
viewport 1440x900
style "#noVNC_control_bar_anchor, #noVNC_status { display: none !important }"
pace 0.55
gif width=720 fps=8

say "GIMP on a Linux desktop in Docker, driven by oxdemo."
double-click @683,113
pause 500ms

say "Render a plasma cloud."
click @393,64
hover @420,459
hover @600,459
hover @720,484
hover @900,484
hover @910,534
click @910,534
pause 1s
click @1050,682

say "Paint on it."
click @77,145
zoom 1.6
draw @330,600 @450,520 @600,580 @750,480 @900,560 @1080,470
key x
draw @330,660 @480,600 @640,650 @800,560 @960,630 @1100,560
zoom off

say "Bend it with Waves."
click @393,64
hover @393,90
hover @422,259
hover @690,259
hover @719,584
click @719,584
pause 1.2s
click @1050,822
pause 500ms

say "All of it came from this script."
click @410,12
pause 500ms
zoom 1.6
hover @300,300
hover @340,560
zoom off
say ""
