# The same tool on a real website: lichess's analysis board.
#
#   oxdemo record examples/lichess/chess.oxd
url https://lichess.org
viewport 1440x900
style "#network-status { display: none !important }"
pace 0.4
theme size=42 offset=70
gif width=720 fps=8

say "It works on websites too."
hover "TOOLS"
click "Analysis board"

say "Buttons by name, pieces by position."
zoom 1.4
drag @773,630 to @773,456
drag @773,195 to @773,369
drag @947,717 to @860,543
zoom off

say "Keys too: L starts the engine."
key l
pause 1s
say ""
